# Чисти адреси: /products вместо /products.html
# Файловете на диска си остават .html - Apache ги намира вътрешно.

Options -MultiViews
RewriteEngine On

# ── работни папки и файлове: да не се отдават публично ─────────────────────
# Листването на папка и без това връщаше 403, но ЕДИНИЧНИТЕ файлове в тях се
# теглеха свободно - проверено на живо: снимка от product_images се сваляше
# с 200 и 1,3 MB. В тази папка стои рекламният материал на производителя,
# част от него с логото на друг магазин, и няма работа на нашия домейн.
# robots.txt само моли да не се обхождат; това тук наистина ги затваря.
# Нито един от тези пътища не се ползва от сайта - проверено с търсене на
# src=/href=/url() по целия построен сайт, включително /en и /ru.
# Едно правило, а не <FilesMatch> с Require: колкото по-малко различни
# директиви, толкова по-малък шансът някоя да не се хареса на сървъра - а
# сгрешен .htaccess сваля ЦЕЛИЯ сайт с 500, не само този ред.
# 404, а не 403: 403 казва "тук има нещо, но не за теб".
# thumbnail е с незадължително .html: правилото за чисти адреси по-долу маха
# разширението ПРЕДИ това правило, тоест /thumbnail.html идва дотук вече като
# /thumbnail и инак се измъкваше.
RedirectMatch 404 ^/(product_images|images|tmp|output|docs)/|^/(support\.js|_ds_bundle\.js|_ds_manifest\.json|_adherence\.oxlintrc\.json)$|^/thumbnail(\.html)?$

# ── страница при сгрешен адрес ─────────────────────────────────────────────
# Пътят е абсолютен (/404.html), защото Apache поднася файла ВЪТРЕШНО, без да
# сменя адреса в лентата: относителните пътища в самата страница биха се
# смятали спрямо изкования адрес. Затова и в 404.html всичко сочи от корена.
# Правилото за 301 по-долу не я закача - то гледа THE_REQUEST, а той пази
# първоначално поисканото, не вътрешното пренасочване.
ErrorDocument 404 /404.html

# ── 301 от старите адреси, за да не се губи вече спечеленото в Google ──────
# /index.html -> /   (важи и за /kategoria/eye/index.html)
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /products.html -> /products   (низът след ? се пренася сам)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /products/ -> /products   (само когато няма такава папка)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── вътрешно: /products поднася products.html ─────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
